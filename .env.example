# --- PostgreSQL ---
# Used by compose.yml (variable substitution) and matches DATABASE_URL below.
POSTGRES_USER=xillow
POSTGRES_PASSWORD=xillow
POSTGRES_DB=xillow

# --- API ---
PORT=3000
# Local (non-Docker) connection. The host port is 5433 to avoid clashing with an
# existing Postgres on the default 5432. In Docker, compose sets DATABASE_URL to
# point at the `db` service on 5432.
DATABASE_URL=postgres://xillow:xillow@localhost:5433/xillow
