# --- PostgreSQL ---
# Used by compose.yml (variable substitution) and matches DATABASE_URL below.
POSTGRES_USER=xillow
POSTGRES_PASSWORD=xillow
POSTGRES_DB=xillow

# --- API ---
PORT=3000
# Local (non-Docker) connection. The host port is 5433 to avoid clashing with an
# existing Postgres on the default 5432. In Docker, compose sets DATABASE_URL to
# point at the `db` service on 5432.
DATABASE_URL=postgres://xillow:xillow@localhost:5433/xillow

# --- Docker host ports (optional) ---
# Published host ports for `npm run docker:up`. Defaults are shown; uncomment to
# override. The API default (3001) differs from the manual API (3000) so the
# Docker stack and `npm run dev` can run at the same time. If you change
# DB_HOST_PORT, update DATABASE_URL above to match.
# API_HOST_PORT=3001
# WEB_HOST_PORT=8080
# DB_HOST_PORT=5433
