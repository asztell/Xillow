{
  "name": "xillow",
  "version": "1.0.0",
  "private": true,
  "description": "Xillow — listing search over multiple MLS feeds (API + UI)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @xillow/api",
    "dev:web": "npm run dev -w @xillow/web",
    "seed": "npm run seed -w @xillow/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
